package templates

import (
	btn "go-htmx-template/templates/components/button"
	inp "go-htmx-template/templates/components/input"
)

// Signup is FULL page. POST /signup re-renders it with errMsg on failure.
templ Signup(errMsg string) {
	@Layout("sign up") {
		<main class="mx-auto max-w-md px-4 py-10">
			<h1 class="text-2xl font-semibold tracking-tight">sign up</h1>
			if errMsg != "" {
				<p class="mt-4 text-sm text-red-600">{ errMsg }</p>
			}
			<form method="post" action="/signup" class="mt-4 flex flex-col gap-2">
				@inp.Input(inp.Props{
					Name: "username",
					Placeholder: "username",
					Required: true,
					Attributes: templ.Attributes{"autocomplete": "username"},
				})
				@inp.Input(inp.Props{
					Name: "password",
					Type: "password",
					Placeholder: "password (min 8 characters)",
					Required: true,
					Attributes: templ.Attributes{"autocomplete": "new-password"},
				})
				@btn.Button(btn.Props{Type: btn.TypeSubmit}) {
					Sign up
				}
			</form>
			<p class="mt-4 text-sm text-neutral-500">
				already have an account?
				@btn.Button(btn.Props{Href: "/signin", Variant: btn.VariantLink, Size: btn.SizeSm, Class: "px-1 text-sm"}) {
					sign in
				}
			</p>
		</main>
	}
}

// Signin is FULL page. POST /signin re-renders it with errMsg on failure.
templ Signin(errMsg string) {
	@Layout("sign in") {
		<main class="mx-auto max-w-md px-4 py-10">
			<h1 class="text-2xl font-semibold tracking-tight">sign in</h1>
			if errMsg != "" {
				<p class="mt-4 text-sm text-red-600">{ errMsg }</p>
			}
			<form method="post" action="/signin" class="mt-4 flex flex-col gap-2">
				@inp.Input(inp.Props{
					Name: "username",
					Placeholder: "username",
					Required: true,
					Attributes: templ.Attributes{"autocomplete": "username"},
				})
				@inp.Input(inp.Props{
					Name: "password",
					Type: "password",
					Placeholder: "password",
					Required: true,
					Attributes: templ.Attributes{"autocomplete": "current-password"},
				})
				@btn.Button(btn.Props{Type: btn.TypeSubmit}) {
					Sign in
				}
			</form>
			<p class="mt-4 text-sm text-neutral-500">
				no account yet?
				@btn.Button(btn.Props{Href: "/signup", Variant: btn.VariantLink, Size: btn.SizeSm, Class: "px-1 text-sm"}) {
					sign up
				}
			</p>
		</main>
	}
}
