package templates

import (
	assets "go-htmx-todo/static"
)

// Layout is the single page shell every full page renders through:
// doctype, head, stylesheet, htmx, and the bfcache reload guard.
// Cross-page behavior lives here once, not per page.
// Asset URLs carry ?v=<content hash> so the immutable Cache-Control on
// /static/ is safe: new content always means a new URL.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - todos</title>
			<link rel="stylesheet" href={ "/static/css/app.css?v=" + assets.Version }/>
			<script src={ "/static/js/htmx.min.js?v=" + assets.Version }></script>
			<script>window.addEventListener("pageshow", function (e) { if (e.persisted) window.location.reload(); });</script>
		</head>
		<body class="bg-neutral-100 font-sans text-neutral-900 antialiased">
			{ children... }
		</body>
	</html>
}
